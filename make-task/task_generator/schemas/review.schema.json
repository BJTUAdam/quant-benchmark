{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["classification","closest_task_id","comparisons","rationale","issues","public_information_safe","long_horizon_valid"],
  "properties":{
    "classification":{"enum":["duplicate","variant","distinct","uncertain"]},
    "closest_task_id":{"type":["string","null"]},
