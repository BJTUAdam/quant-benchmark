    "rationale":{"type":"string","minLength":1},
    "issues":{"type":"array","items":{"type":"string"}},
    "pending_bindings":{"type":"array","items":{"type":"string"}},
    "public_information_safe":{"type":"boolean"},
    "long_horizon_valid":{"type":"boolean"}
  }
}
