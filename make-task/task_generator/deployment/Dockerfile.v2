FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30 AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /opt/finlab
COPY deployment/requirements.v2.lock /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && useradd --uid 10001 --create-home runner
ENV PYTHONPATH=/opt/finlab
USER 10001:10001
FROM base AS engine
COPY finlab/__init__.py finlab/common.py finlab/data.py finlab/temporal.py finlab/catalog.py finlab/disclosure.py finlab/server.py finlab/engine.py /opt/finlab/finlab/
ENTRYPOINT ["python", "-m", "finlab.engine"]
FROM base AS worker
COPY finlab/__init__.py finlab/common.py finlab/sdk.py finlab/tushare.py /opt/finlab/finlab/
ENTRYPOINT ["python", "/submission/backtest.py"]
