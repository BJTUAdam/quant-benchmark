  "research_question": "同一股票池内如何让选入排名、留存门槛、换仓预算和资金分配协同？",
  "research_modules": [
    {
      "decision_id": "feature_definition",
      "description": "定义基于已知量价的相对强弱特征并统一比较尺度。",
      "interaction": "特征尺度影响合成排名和持股集中度。"
    },
    {
      "decision_id": "rank_aggregation",
      "description": "研究多个强弱尺度如何合成以及候选并列处理。",
      "interaction": "排名变化不必立即转成交易。"
    },
    {
      "decision_id": "holding_buffer",
      "description": "分别研究新选入和继续持有门槛。",
      "interaction": "缓冲影响换手和机会占用。"
    },
    {
      "decision_id": "turnover_budget",
      "description": "研究单次换仓预算与成本敏感性。",
      "interaction": "预算下优先替换谁，需要综合旧仓和新排名。"
    },
    {
      "decision_id": "capital_allocation",
      "description": "决定股票权重、闲置现金和集中度。",
      "interaction": "实际T+1可卖量与拒单可能使目标组合无法一步达到。"
    }
  ],
  "maintenance_rationale": "市场中强弱持续性、排名稳定性和换手代价可能改变；可维护因子组合、缓冲和资金分配，但不要求每段都修改。",
