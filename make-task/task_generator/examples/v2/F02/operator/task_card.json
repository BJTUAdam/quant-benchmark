  "research_question": "何时仍是区间边缘回归，何时应判定结构进入趋势并停止逆势参与？",
  "research_modules": [
    {
      "decision_id": "range_detection",
      "description": "研究何种历史结构足以认定当前仍在区间内。",
      "interaction": "结构有效期决定参考水平是否继续适用。"
    },
    {
      "decision_id": "reference_estimation",
      "description": "研究区间参考水平、边缘及其更新方式。",
      "interaction": "参考水平改变偏离尺度；更新不能抹掉已经发生的亏损。"
    },
    {
      "decision_id": "deviation_measurement",
      "description": "比较偏离边界与波动标准化的回归机会。",
      "interaction": "偏离只有在趋势否决通过时才可参与。"
    },
    {
      "decision_id": "trend_veto",
      "description": "研究何时否决逆势入场，并处理区间向趋势的失效。",
      "interaction": "否决应同时考虑旧仓退出，不能只禁止新仓。"
    },
    {
      "decision_id": "exit_policy",
      "description": "研究回归完成、时间耗尽和失败退出。",
      "interaction": "T+1限制使退出不能假设当日新仓即时止损。"
    },
    {
      "decision_id": "reentry_policy",
      "description": "区间失效后何时恢复或重建参考。",
      "interaction": "旧区间memory与新参考版本需明确兼容。"
    }
  ],
  "maintenance_rationale": "后续阶段可能从区间进入趋势；需要维护参考水平、否决条件和恢复规则。维护是否有效须数据和实际轨迹另验。",
