  "research_question": "同品种近远月价差如何随剩余期限、流动性与到期迁移保持可交易？",
  "research_modules": [
    {
      "decision_id": "pair_selection",
      "description": "按当时可见到期、成交和持仓信息选同品种近远月。",
      "interaction": "不能用全样本最活跃合约或事后主力映射。"
    },
    {
      "decision_id": "tenor_normalization",
      "description": "研究期限差和剩余到期变化下价差的可比表达。",
      "interaction": "同一价差点位在不同期限上不必具有相同意义。"
    },
    {
      "decision_id": "entry_exit",
      "description": "研究近远月相对关系的参与和退出。",
      "interaction": "价差只产生信号，交易实际合约手数。"
    },
    {
      "decision_id": "margin_budget",
      "description": "按实际双腿计算风险和保证金。",
      "interaction": "不假设跨期保证金优惠，服从固定执行器上限。"
    },
    {
      "decision_id": "roll_policy",
      "description": "研究配对到期前退出、迁移和新对建立。",
      "interaction": "必须计入平旧开新成本并处理逐腿部分成交。"
    },
    {
      "decision_id": "state_migration",
      "description": "配对标识和逻辑更新时迁移旧腿状态。",
      "interaction": "旧合约不能因新配对选中而从目标头寸中被遗忘。"
    }
  ],
  "maintenance_rationale": "近远月关系受期限缩短、流动性切换和到期迁移影响，维护对象同时包括信号与合约生命周期；同日多月份数据与适配器仍待确认。",
