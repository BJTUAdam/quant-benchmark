  "research_question": "状态辨识与切换控制如何决定策略参与和预算，并接住旧状态和未清仓头寸？",
  "research_modules": [
    {
      "decision_id": "state_identification",
      "description": "用当时已知量价定义趋势、震荡或不确定状态。",
      "interaction": "状态定义需与参与规则一起研究，不能用未来收益作标签输入。"
    },
    {
      "decision_id": "switch_hysteresis",
      "description": "研究状态切换确认、迟滞和驻留。",
      "interaction": "减少抖动会增加状态变化后的反应延迟。"
    },
    {
      "decision_id": "participation_policy",
      "description": "把状态映射到趋势/回归模块的参与或停用。",
      "interaction": "需记录透明模块定义；暂停新增不等于立即清空旧仓。"
    },
    {
      "decision_id": "risk_budget",
      "description": "研究各参与模块与现金的预算。",
      "interaction": "预算服从固定硬上限，不允许优化账户规则。"
    },
    {
      "decision_id": "state_migration",
      "description": "控制器更新时迁移模块状态及旧持仓。",
      "interaction": "不能重置memory、现金或用新规则覆盖过去正式结果。"
    }
  ],
  "maintenance_rationale": "状态分界可能漂移，切换迟滞与风险预算会产生不同延迟；维护核心是控制器而非反复调单个入场阈值。实际长程区分度待管线验证。",
