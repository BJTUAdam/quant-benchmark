  "research_question": "FU/LU关系变化时如何重估对冲、暂停参与并迁移实际双腿头寸？",
  "research_modules": [
    {
      "decision_id": "month_selection",
      "description": "研究FU/LU月份匹配与共同可交易条件。",
      "interaction": "月份选择改变对冲关系和移仓成本。"
    },
    {
      "decision_id": "hedge_estimation",
      "description": "仅用历史估计滚动对冲关系并转成整数手数。",
      "interaction": "残差信号和真实腿名义敞口不能混用。"
    },
    {
      "decision_id": "entry_exit",
      "description": "研究残差参与、退出、止损和时间限制。",
      "interaction": "信号变化需落实为真实腿目标，不能买卖负价差本身。"
    },
    {
      "decision_id": "relationship_monitoring",
      "description": "研究何时判定关系失效、暂停和重估。",
      "interaction": "重估改变对冲比例，必须明确处置旧腿。"
    },
    {
      "decision_id": "margin_budget",
      "description": "按乘数、费用和保证金计算组合手数。",
      "interaction": "预算、逐腿部分成交和残余敞口会改变信号实际实现。"
    },
    {
      "decision_id": "state_migration",
      "description": "关系版本更新和换月时处理旧仓及memory。",
      "interaction": "只有未来决策采用新定义，过去正式结果不可重写。"
    }
  ],
