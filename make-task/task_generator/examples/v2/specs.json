    "research_question": "如何使区间识别、突破确认、失败处置与再次参与形成可维护的状态流程？",
    "research_modules": [
      {
        "decision_id": "range_detection",
        "description": "研究只使用已完成K线的整理区间、边界更新和失效状态。",
        "interaction": "边界更新改变确认门槛及失败判断，不可事后重画区间。"
      },
      {
        "decision_id": "entry_confirmation",
        "description": "比较突破后的等待、量价确认与可成交时点。",
        "interaction": "等待会改变持有期、T+1库存和机会排序。"
      },
      {
        "decision_id": "failure_exit",
        "description": "研究突破失败与正常回踩的区别及已有仓位退出。",
        "interaction": "退出时刻约束再次参与，不能用未来最低价标记假突破。"
      },
      {
        "decision_id": "reentry_policy",
        "description": "设计失败后冷却与结构重建后的再次参与。",
        "interaction": "memory保留旧失败状态，与新区间编号和旧持仓兼容。"
      },
      {
        "decision_id": "capital_allocation",
        "description": "在同时触发的候选间分配现金和权重。",
        "interaction": "资金竞争与T+1不可卖仓位影响信号实际实现。"
      }
    ],
